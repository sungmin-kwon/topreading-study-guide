# PostgreSQL runtime. Use a non-owner role; migration credentials stay separate.
DATABASE_URL=postgresql://topreading_app:CHANGE_ME@127.0.0.1:5432/topreading
DATABASE_SCHEMA=topreading
# MIGRATION_DATABASE_URL is supplied only to migration commands, not the web service.

# Durable absolute paths in production. Source files remain on disk in this phase.
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
BACKUP_DIR=./backups
PYTHON_EXECUTABLE=

APP_BASE_URL=https://top.dubugimchi.com
AUTH_URL=https://top.dubugimchi.com
AUTH_MODE=google
# Generate a random secret (at least 32 characters). Configure locally; never commit it.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google callback: https://top.dubugimchi.com/api/auth/callback/google
# Existing active users with library membership can sign in. No public registration.

# Alternative: AUTH_MODE=cloudflare_access, with signed Access JWT verification.
# This is the Zero Trust team domain, NOT top.dubugimchi.com.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
AUTH_ALLOWED_EMAILS=

# Local disposable development only: set AUTH_MODE=off, APP_BASE_URL to loopback,
# ALLOW_INSECURE_LOCAL_AUTH=true, DEV_USER_EMAIL to a pre-created local test user,
# and bind next start/dev to 127.0.0.1. Never use this bypass behind a public proxy.
ALLOW_INSECURE_LOCAL_AUTH=false
DEV_USER_EMAIL=

OPENAI_API_KEY=
# Model and generation limits are managed in Admin and stored in PostgreSQL.
MCQ_REVIEW_MAX_CALLS=12
