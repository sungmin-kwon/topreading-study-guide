# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Local SQLite database. Keep file: prefix for better-sqlite path parsing.
DATABASE_URL=file:./data/dev.db

# Runtime storage. Use durable absolute paths in production.
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
BACKUP_DIR=./backups

# Optional. On Windows local dev, this can point to ./.topreading/Scripts/python.exe.
# If omitted, source extraction uses "python" and PDF/DOCX export uses .topreading/Scripts/python.exe.
PYTHON_EXECUTABLE=

# Optional app URL for deployment notes/integrations.
APP_BASE_URL=http://localhost:3000

# Optional auth. Keep AUTH_MODE=off for local development.
# For Cloudflare Access, set AUTH_MODE=cloudflare_access and comma-separate allowed emails.
# For nginx/proxy-injected shared secret, set AUTH_MODE=shared_secret and configure the proxy
# to inject X-TopReading-Auth-Secret with AUTH_SHARED_SECRET.
AUTH_MODE=off
AUTH_ALLOWED_EMAILS=
APP_ADMIN_EMAILS=
DEV_USER_EMAIL=
AUTH_SHARED_SECRET=

# Generation guardrails
MAX_GENERATION_CHAPTERS=80
MAX_GENERATION_ITEMS=2500
